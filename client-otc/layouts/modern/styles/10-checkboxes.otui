CheckBox < UICheckBox
  size: 16 16
  text-align: left
  text-offset: 18 1
  color: #2e2e38
  image-color: #ffffffff
  image-rect: 0 0 15 15
  image-source: /images/ui/checkbox
  change-cursor-image: true
  cursor: pointer

  $hover !disabled:
    color: #2e2e38

  $!checked:
    image-clip: 0 0 15 15

  $hover !checked:
    image-clip: 0 15 15 15

  $checked:
    image-clip: 0 30 15 15

  $hover checked:
    image-clip: 0 45 15 15

  $disabled:
    image-color: #ffffff88
    color: #2e2e3888
    opacity: 0.8
    change-cursor-image: false

ColorBox < UICheckBox
  size: 16 16
  image-color: #ffffffff
  image-source: /images/ui/colorbox

  $checked:
    image-clip: 16 0 16 16

  $!checked:
    image-clip: 0 0 16 16

ButtonBox < UICheckBox
  font: verdana-11px-antialised
  color: #2e2e38
  size: 106 23
  text-offset: 0 0
  text-align: center
  image-source: /images/ui/button
  image-color: #ffffff
  image-clip: 0 0 22 23
  image-border: 3
  change-cursor-image: true
  cursor: pointer

  $hover !disabled:
    image-clip: 0 23 22 23

  $checked:
    image-clip: 0 46 22 23
    color: #2e2e38

  $disabled:
    color: #2e2e3888
    image-color: #ffffff88
    change-cursor-image: false

ButtonBoxRounded < ButtonBox
  image-source: /images/ui/button_rounded
